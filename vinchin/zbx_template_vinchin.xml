                            </master_item>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>1e1c9e21752545c2804fb5421abfc59c</uuid>
                            <expression>last(/Vinchin Backup and Recovery by API/vinchin.job.status[{#JOB_UUID}])&gt;=4</expression>
