                    <master_item>
                        <key>vinchin.jobs[{$VINCHIN.URL},{$VINCHIN.USERNAME},{$VINCHIN.PASSWORD}]</key>
                    </master_item>
                    <lld_macro_paths>
                        <lld_macro_path>
                            <lld_macro>{#JOB_UUID}</lld_macro>
                            <path>$.job_uuid</path>
                        </lld_macro_path>
                        <lld_macro_path>
                            <lld_macro>{#JOB_NAME}</lld_macro>
                            <path>$.job_name</path>
                        </lld_macro_path>
                    </lld_macro_paths>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>e578751e4af746039d95a4be3bf2714f</uuid>
                            <name>Job {#JOB_NAME}: Status</name>
                            <type>DEPENDENT</type>
                            <key>vinchin.job.status[{#JOB_UUID}]</key>
                            <delay>0</delay>
                            <history>30d</history>
                            <trends>0</trends>
                            <value_type>UNSIGNED</value_type>
                            <valuemap>
                                <name>Vinchin job status</name>
                            </valuemap>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.rows[?(@.job_uuid == "{#JOB_UUID}")].status.first()</parameter>
                                    </parameters>
                                    <error_handler>DISCARD_VALUE</error_handler>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>vinchin.jobs[{$VINCHIN.URL},{$VINCHIN.USERNAME},{$VINCHIN.PASSWORD}]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>3f43858d1e5c4e6995b3da3161c57d6b</uuid>
                            <name>Job {#JOB_NAME}: Last result</name>
                            <type>DEPENDENT</type>
                            <key>vinchin.job.last_result[{#JOB_UUID}]</key>
                            <delay>0</delay>
                            <history>30d</history>
                            <trends>0</trends>
                            <value_type>UNSIGNED</value_type>
                            <valuemap>
                                <name>Vinchin last result</name>
                            </valuemap>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.rows[?(@.job_uuid == "{#JOB_UUID}")].last_result.first()</parameter>
                                    </parameters>
                                    <error_handler>DISCARD_VALUE</error_handler>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>vinchin.jobs[{$VINCHIN.URL},{$VINCHIN.USERNAME},{$VINCHIN.PASSWORD}]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>f062a99848e9488689135e140e68553b</uuid>
                            <name>Job {#JOB_NAME}: Last run start</name>
                            <type>DEPENDENT</type>
                            <key>vinchin.job.last_start[{#JOB_UUID}]</key>
                            <delay>0</delay>
                            <history>30d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
