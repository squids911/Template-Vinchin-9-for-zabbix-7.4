                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items>
                <item>
                    <uuid>34d305e465f340978562aaa2768348d0</uuid>
                    <name>Vinchin: Summary JSON</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>vinchin.summary[{$VINCHIN.URL},{$VINCHIN.USERNAME},{$VINCHIN.PASSWORD}]</key>
                    <delay>1m</delay>
                    <history>7d</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <triggers>
                        <trigger>
                            <uuid>7632a3c50601422db33022b9b61ea81b</uuid>
                            <expression>nodata(/Vinchin Backup and Recovery by API/vinchin.summary[{$VINCHIN.URL},{$VINCHIN.USERNAME},{$VINCHIN.PASSWORD}],5m)=1</expression>
                            <name>Vinchin: no data collected</name>
                            <priority>WARNING</priority>
                            <description>Данные не поступают 5 минут — проверьте агент, конфиг и доступность API.</description>
