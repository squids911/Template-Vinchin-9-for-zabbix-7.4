            <discovery_rules>
                <discovery_rule>
                    <uuid>dae2afb8a86444c5969f22726b349483</uuid>
                    <name>Vinchin jobs discovery</name>
                    <type>DEPENDENT</type>
                    <key>vinchin.jobs.discovery</key>
                    <delay>0</delay>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.rows</parameter>
                            </parameters>
                            <error_handler>DISCARD_VALUE</error_handler>
                        </step>
